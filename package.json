{
  "name": "ai-router",
  "version": "1.0.0",
  "description": "Desktop AI chat client with automatic failover across multiple AI providers",
  "main": "./out/main/index.js",
  "author": "AI Router",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --config",
    "dist:dir": "electron-vite build && electron-builder --win --dir --config",
    "test:failover": "npx tsx src/main/router/failover-engine.test.ts"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
